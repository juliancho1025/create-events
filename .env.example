# --- API ---
PORT=3000
WEB_URL=http://localhost:5173
MONGO_URI=mongodb://localhost:27017/events

# Sign the JWTs. Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma-separated emails that get the ADMIN role on login
ADMIN_EMAILS=admin@example.com

# Dev-only login bypass (no Google needed). NEVER enable in production.
DEV_LOGIN_ENABLED=true

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# S3-compatible storage (SeaweedFS locally, AWS S3 in prod: drop S3_ENDPOINT)
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=event-images
S3_ACCESS_KEY_ID=local
S3_SECRET_ACCESS_KEY=local
S3_FORCE_PATH_STYLE=true
